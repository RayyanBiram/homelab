# /etc/fstab mount entries for the K10 home server
# These mount NAS shares and the external backup drive as local directories
# Docker containers reference these paths in their volume mappings

# ── NAS SHARES (NFS) ──
# UGREEN NAS exports shares by volume path (/volumeN/share), not by share name.
# Check the real export paths with: showmount -e 192.168.1.100
# _netdev = wait for the network before mounting (prevents boot failures)
192.168.1.100:/volume1/photos  /mnt/nas/photos  nfs  defaults,_netdev  0  0
192.168.1.100:/volume2/data    /mnt/nas/data    nfs  defaults,_netdev  0  0

# ── EXTERNAL BACKUP DRIVE (USB 3.0) ──
# nofail = don't block boot if the drive is unplugged
# Replace UUID with your drive's actual UUID (find with: sudo blkid)
UUID=your-drive-uuid-here  /mnt/backup  ext4  defaults,nofail  0  2
