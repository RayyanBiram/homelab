# Copy this file to ~/docker/.env and fill in real values.
# Never commit .env - only this .example file.

# Cloudflare Tunnel token
# Get from: dash.cloudflare.com → Zero Trust → Networks → Tunnels
CF_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Immich database password (must match DB_PASSWORD in immich.env)
IMMICH_DB_PASSWORD=change_this_to_a_strong_password
